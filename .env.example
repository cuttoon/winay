# Local development only. In Azure these values come from App Settings / Key Vault.
# Load them in your shell before running, e.g.:  export $(grep -v '^#' .env | xargs)

PORT=3000
NODE_ENV=development

# Leave STORAGE_ACCOUNT_NAME empty to read content from data/content/resources.json
STORAGE_ACCOUNT_NAME=
CONTENT_CONTAINER=content
CONTENT_BLOB=resources.json

# Enables POST /api/v1/admin/content/refresh (send it in the x-api-key header)
ADMIN_API_KEY=local-dev-key
